{
  "name": "conformite-travaux-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/typo-fr.mjs dist",
    "preview": "PUBLIC_PREVIEW=1 astro build --outDir dist-preview && node scripts/flatten-preview.mjs dist-preview && node scripts/typo-fr.mjs dist-preview",
    "audit": "node scripts/audit.mjs dist",
    "audit:preview": "node scripts/audit.mjs dist-preview",
    "check": "npm run build && npm run audit",
    "veille": "python3 -I scripts/audit-live.py"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "astro": "^5.0.0"
  }
}